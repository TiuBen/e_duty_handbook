/* components/form-cell/form-cell.wxss */
.cell {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 20rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f1f3;
}

.cell:last-child {
  border-bottom: none;
}

.cell-gray .cell-label {
  color: #b9bec7;
}

.cell-label {
  font-size: 30rpx;
  color: #1f2329;
  flex-shrink: 0;
}

.cell-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-left: 20rpx;
  min-width: 0;
}

.cell-value {
  font-size: 30rpx;
  color: #1f2329;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-value.is-placeholder {
  color: #b9bec7;
}

.cell-value.is-gray {
  color: #b9bec7;
}

.cell-arrow {
  margin-left: 10rpx;
  color: #c2c6cd;
  font-size: 34rpx;
  line-height: 1;
}
