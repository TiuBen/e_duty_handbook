/* pages/task-detail/index.wxss */
.form-header {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 32rpx 0;
}

.form-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1677ff;
}

.form-close {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #1677ff;
}

.btn-next {
  margin: 40rpx 24rpx 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #1677ff;
  color: #fff;
  font-size: 32rpx;
}

.btn-delete {
  margin: 0 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #f53f3f;
  color: #fff;
  font-size: 32rpx;
  margin-bottom: env(safe-area-inset-bottom);
}
