/* pages/simulator-form/index.wxss */
.page {
  padding-bottom: 60rpx;
}

.form-header {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 32rpx 0;
}

.form-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1677ff;
}

.form-close {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #1677ff;
}

.tip-red {
  margin: 8rpx 24rpx 20rpx;
  font-size: 28rpx;
  color: #f53f3f;
  line-height: 1.5;
}
