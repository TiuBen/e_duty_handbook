/* pages/profile/index.wxss */
.page {
  padding: 20rpx 0 60rpx;
}

.user-card {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 40rpx 28rpx;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #1677ff;
  color: #fff;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-info {
  margin-left: 24rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}

.user-role {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8a8e99;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-name {
  font-size: 30rpx;
  color: #1f2329;
}

.menu-arrow {
  font-size: 34rpx;
  color: #c2c6cd;
}
