/* pages/score/index.wxss - 评分页 */
.page {
  padding-bottom: env(safe-area-inset-bottom);
}

.groups {
  margin: 12rpx 24rpx;
}

.group {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.group-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.group-arrow {
  font-size: 28rpx;
  color: #8a8e99;
  transition: transform 0.2s;
}

.group-arrow.open {
  transform: rotate(180deg);
}

.score-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-top: 1rpx solid #f0f1f3;
}

.item-name {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.5;
  margin-right: 20rpx;
}

.item-score {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1f2329;
  flex-shrink: 0;
}

.item-counter {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.counter-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 30rpx;
}

.counter-btn.minus {
  border: 2rpx solid #f53f3f;
  color: #f53f3f;
}

.counter-btn.plus {
  background: #f53f3f;
  color: #fff;
}

.counter-num {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
}

/* 得分区 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.row-label {
  font-size: 30rpx;
  color: #1f2329;
}

.row-value {
  font-size: 30rpx;
  color: #1677ff;
  font-weight: 700;
}

.overall {
  padding: 28rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.overall-input {
  margin-top: 20rpx;
  width: 100%;
  height: 200rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.overall-placeholder {
  color: #f53f3f;
}

.attach {
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.attach-cam {
  margin-left: 40rpx;
  width: 120rpx;
  height: 120rpx;
  background: #f2f3f5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.btn-submit {
  margin: 40rpx 24rpx 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #23b26d;
  color: #fff;
  font-size: 32rpx;
}

.btn-prev {
  margin: 0 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #f5a623;
  color: #fff;
  font-size: 32rpx;
}
