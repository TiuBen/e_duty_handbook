{
  "name": "voicerec-asr",
  "version": "1.0.0",
  "description": "本地 ASR 服务：SenseVoice Small (sherpa-onnx) + Node.js/Express + SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
