# HTTP 服务端口（避开 Windows 保留端口段 5184-5283）
PORT=5300

# 模型目录名（对应 models/ 下的目录）
MODEL_DIR=sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17

# 使用的模型文件: model.int8.onnx (CPU 快) / model.onnx (fp16 更准)
MODEL_FILE=model.int8.onnx

# 识别语种: auto / zh / en / yue / ja / ko
MODEL_LANGUAGE=auto

# 逆文本正则化: 数字与标点转写 (true/false)
MODEL_USE_ITN=true

# 推理线程数
MODEL_NUM_THREADS=4
